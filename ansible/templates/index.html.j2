<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }}</title>
  <style>
    body{font-family:system-ui,Arial,sans-serif;background:#0f172a;color:#e2e8f0;
         display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0}
    .card{background:#1e293b;padding:2.5rem 3rem;border-radius:14px;max-width:640px}
    h1{margin-top:0;color:#38bdf8}
    td{padding:.4rem 1rem .4rem 0;border-bottom:1px solid #334155}
    td:first-child{color:#94a3b8}
  </style>
</head>
<body>
  <div class="card">
    <h1>{{ site_title }}</h1>
    <p>Deployed automatically with Terraform, Ansible, AWS EC2 and Nginx.</p>
    <table>
      <tr><td>Student</td><td>{{ student_name }} ({{ reg_no }})</td></tr>
      <tr><td>Server hostname</td><td>{{ ansible_facts['hostname'] }}</td></tr>
      <tr><td>Operating system</td><td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td></tr>
      <tr><td>Web user</td><td>{{ web_user }}</td></tr>
    </table>
  </div>
</body>
</html>
